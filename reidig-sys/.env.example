# Salin ke .env lalu sesuaikan. Semua variabel berawalan REIDIG_.
REIDIG_ENV=dev
REIDIG_DATABASE_URL=sqlite:///./reidig.db
# REIDIG_DATABASE_URL=postgresql+psycopg://reidig:reidig@localhost:5432/reidig
REIDIG_REDIS_URL=redis://localhost:6379/0

# Dev: buat tabel otomatis dan isi data contoh. Produksi: false, lalu `alembic upgrade head`.
REIDIG_AUTO_CREATE_SCHEMA=true
REIDIG_SEED_DEMO=true

# Rahasia: wajib diganti di luar dev.
REIDIG_IFORTEPAY_SECRET=dev-ifortepay-secret
REIDIG_FINANCING_PARTNER_SECRET=dev-partner-secret
REIDIG_NIK_PEPPER=dev-nik-pepper
REIDIG_KYC_AUTO_APPROVE=true

# Aturan bisnis (nilai sementara)
REIDIG_QUOTE_TTL_SECONDS=60
REIDIG_PAYMENT_WINDOW_SECONDS=900
REIDIG_HOLDING_PERIOD_SECONDS=86400
REIDIG_PRICE_MAX_AGE_SECONDS=0
REIDIG_TOPUP_ENABLED=false
